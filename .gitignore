# ============================================================
# GNOME Desktop Intelligence - .gitignore
# ============================================================

# Build / package output
build/
dist/
out/
release/
*.zip
*.tar
*.tar.gz
*.tgz
*.deb
*.rpm

# GNOME / GSettings generated files
schemas/gschemas.compiled
**/schemas/gschemas.compiled

# Generated validation / screenshots / test output
validation/
screenshots/
test-output/
test-results/
coverage/
.nyc_output/

# Temporary / runtime files
tmp/
temp/
.cache/
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.old
*.orig
*.rej
*.pid
*.lock
*.log

# Local databases / learning state / runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
data/
local-data/
runtime/
state/

# Local environment / secrets
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
credentials/
credentials.json
local-config.*
config.local.*
settings.local.*

# IDE / editor state
.idea/
.vscode/
*.code-workspace
.project
.settings/
*.sublime-project
*.sublime-workspace

# OS / desktop junk
.DS_Store
Thumbs.db
desktop.ini
.directory

# Node / JS tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Python tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

